# ==============================================================================
# AuctionPro — Production Secrets & Environment Variables Template
# ==============================================================================
# IMPORTANT: Store production values in AWS Secrets Manager, Google Secret Manager,
# Azure Key Vault, Vercel, or Railway Environment Variables.
# NEVER commit real credentials to GitHub!
# ==============================================================================

# Server Port
PORT=8000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/auctionpro?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@cluster0.ikc0krh.mongodb.net/auctionpro?retryWrites=true&w=majority

# JWT Token Secret (Min 32 characters, rotate every ~90 days)
JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production_2024

# Razorpay India Payment Gateway API Credentials
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Cloudflare Turnstile Bot Protection Secret Key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
