# ==============================================================================
# AuctionPro — Production Secrets & Environment Variables Template
# ==============================================================================
# Store production secrets in Vercel, Railway, AWS Secrets Manager, or Secret Manager.
# NEVER commit production secrets or real database credentials to Git!
# ==============================================================================

# Node.js Server Port
PORT=8000

# MongoDB Atlas Connection String (Encrypted at rest, TLS in transit)
MONGO_URL=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster.mongodb.net/auctionpro?retryWrites=true&w=majority

# JWT Token Secret (Min 32 characters)
JWT_SECRET=your_secure_random_32_character_jwt_secret_key

# Razorpay Payment Credentials
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_api_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_key

# Allowed CORS Origins & Frontend Live Domain
FRONTEND_URL=https://auctionpro-eight.vercel.app
CORS_ORIGINS=https://auctionpro-eight.vercel.app,http://localhost:3000

# Bot Protection Secret
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
