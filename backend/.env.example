# ─────────────────────────────────────────────────────────────────────────────
# AuctionPro — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in YOUR real values below
#   3. NEVER commit the .env file to GitHub
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Get a free MongoDB cluster at https://cloud.mongodb.com
MONGO_URL=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.xxxxx.mongodb.net/
DB_NAME=auctionpro

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<REPLACE_WITH_STRONG_RANDOM_SECRET>

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL in production
# Example: https://auctionpro.vercel.app
CORS_ORIGINS=http://localhost:3000

# ── Razorpay Payments ─────────────────────────────────────────────────────────
# Get your keys at https://dashboard.razorpay.com/app/keys
# Use rzp_test_... for testing, rzp_live_... for real payments
RAZORPAY_KEY_ID=<YOUR_RAZORPAY_KEY_ID>
RAZORPAY_KEY_SECRET=<YOUR_RAZORPAY_KEY_SECRET>

# ── File Uploads ──────────────────────────────────────────────────────────────
# Local folder for uploaded images (use S3/Cloudflare R2 in production)
UPLOAD_DIR=uploads
