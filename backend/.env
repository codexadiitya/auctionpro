# ============================================================
# AuctionPro Backend Environment Variables
# REPLACE ALL VALUES BELOW BEFORE DEPLOYING TO PRODUCTION
# ============================================================

# MongoDB connection (use Atlas in production)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="auctionpro_prod"

# JWT secret — generate a strong one with:
# python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use this placeholder in production!
JWT_SECRET="change-me-to-a-strong-random-secret-before-deploying"

# CORS — set to your actual frontend domain in production
# e.g. CORS_ORIGINS=https://yourdomain.com
CORS_ORIGINS="*"

# Stripe — replace with real keys from https://dashboard.stripe.com
STRIPE_API_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET=""

# Upload directory (use absolute path or S3 in production)
UPLOAD_DIR="uploads"
